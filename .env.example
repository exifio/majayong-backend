# 환경 변수 이름 예시 (값은 커밋하지 않는다)
# Vercel/Supabase: DATABASE_URL은 런타임 pooler, MIGRATION_DATABASE_URL은 direct 연결.
DATABASE_URL=postgresql://localhost:5432/majayong
MIGRATION_DATABASE_URL=
PORT=3000
NODE_ENV=development

# 인증 (A 담당 계약)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 외부 연동 (C 담당)
TOSS_CLIENT_KEY=
# Toss PG API 개별 연동 secret key (`test_sk`/`live_sk`): paymentKey/orderId 조회 및 승인용
TOSS_SECRET_KEY=
# API 개별 연동 키의 보안 키(64자리 hex): Toss 웹훅 HMAC 서명 검증 전용
TOSS_WEBHOOK_SECRET=
TOSS_SANDBOX_BASE_URL=https://api.tosspayments.com

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI (A 담당)
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_USD_TO_KRW_RATE=1350

# A 인증 (세션 토큰 서명, 32바이트 이상)
TOKEN_SECRET=
GOOGLE_REDIRECT_URI=

# 배치 (기본 false. 배포에서는 실제 스케줄러/워커로 실행)
JOB_SCHEDULER_ENABLED=false

# A 프로필
PROFILE_DATA_KEY=
SUPPLIER_NDA_VERSION=
PROJECT_DISCLOSURE_CONSENT_VERSION=
ALLOW_LOCAL_AUTH=

# C (Toss webhook / Supabase storage)

SUPABASE_STORAGE_BUCKET=
