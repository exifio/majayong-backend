{
  "name": "majayong",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node --env-file=.env dist/index.js",
    "test": "npm run test:b && npm run test:c && npm run test:a",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:staging": "node --env-file=.env scripts/migrate-staging.mjs",
    "db:migrate:production": "node --env-file=.env scripts/migrate-production.mjs",
    "db:seed:staging": "node scripts/seed-staging.mjs",
    "db:seed:demo": "node scripts/seed-demo-fixtures.mjs",
    "db:verify:b": "node scripts/verify-b-pg.mjs",
    "test:a": "jest --runInBand",
    "test:b": "DATABASE_URL=\"${DATABASE_URL:-}\" node --import ./tests/b/resolve-ts.mjs --test $(find src openapi -name '*.b.test.ts')",
    "test:c": "DATABASE_URL=\"${DATABASE_URL:-}\" node --test $(find src -name '*.c.test.ts')",
    "test:integration": "DATABASE_URL=\"${DATABASE_URL:-}\" node --import ./tests/b/resolve-ts.mjs --test $(find src -name '*.int.test.ts')",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "check:rules": "node scripts/check-rules.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prisma": "^6.19.3",
    "typescript": "^7.0.2",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.2"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0"
  }
}
